# Backend (Spring Boot reads these as environment variables)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/zomato_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
APP_JWT_SECRET=            # at least 32 random bytes, e.g. `openssl rand -base64 48`

# Frontend (Vite) — set in frontend/.env.local
VITE_API_URL=http://localhost:8080/api
